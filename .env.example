# Atlas runtime configuration. Never commit a real private key or production secret.
NODE_ENV=development
RPC_URL=http://host.docker.internal:8545
CHAIN_ID=31337
JWT_SECRET=
ENDPOINT_KEY=
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:8080
# Leave blank for the Docker same-origin /api proxy. Set an HTTPS API URL only
# when the frontend is hosted separately from the API.
VITE_API=
TRUST_PROXY=1
DATA_DIR=/data
MAX_UPLOAD_MB=100
ALLOW_PRIVATE_ENDPOINTS=false

# Account authentication. Google values come from a Web application OAuth client.
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Production email verification and password reset delivery.
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
AUTH_EMAIL_FROM=Atlas <auth@your-domain.example>
RESEND_API_URL=https://api.resend.com/emails

# Optional managed Hugging Face inference. Create a fine-grained token with
# "Make calls to Inference Providers" permission and keep it server-side only.
HF_API_TOKEN=
HF_API_URL=https://huggingface.co/api/models
HF_INFERENCE_URL=https://api-inference.huggingface.co/models
ALLOWED_HF_LICENSES=apache-2.0,mit,bsd,bsd-2-clause,bsd-3-clause,cc-by,cc-by-4.0,openrail,openrail++,bigscience-openrail-m,creativeml-openrail-m

# Model verification. Development auto-approves after the creator signs the
# attestation only when every low-risk check passes. The bot never grants roles,
# approves KYC/evidence, performs takedowns, or handles payments.
ENABLE_AUTOMATED_MODERATION=true
AUTO_TRIAGE_REPORTS=true
ALLOWED_MODEL_LICENSES=mit,apache-2.0,bsd,bsd-2-clause,bsd-3-clause,cc-by,cc-by-4.0,openrail,openrail++,bigscience-openrail-m,creativeml-openrail-m,commercial,proprietary,custom
AUTO_APPROVE_MODEL_VERIFICATION=true
# Production should explicitly enable automation only after review. Identity and
# licence evidence still stay pending until a human admin reviews them.
REQUIRE_KYC_FOR_LISTING=false
REQUIRE_MALWARE_SCAN=false
# Optional ClamAV daemon (for Docker: start the security profile and use
# CLAMAV_HOST=clamav). The basic format scan still runs without it.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Optional ETH-to-INR display quote when showing both payment rails.
INR_PER_ETH=0
# The first administrator. On startup Atlas bootstraps this wallet with the
# admin role; additional reviewers/moderators are managed from the Admin console.
ADMIN_WALLET=

# Razorpay test-mode checkout for INR/UPI. Never put the secret in Vite/frontend variables.
ENABLE_INR_PAYMENTS=false
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Deployment-only values; use only on Sepolia and remove from the runtime environment.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
DEPLOYER_KEY=0xYOUR_THROWAWAY_SEPOLIA_PRIVATE_KEY
